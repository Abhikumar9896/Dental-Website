# SMTP details for sending appointment form emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@gmail.com
SMTP_PASS=your-smtp-app-password
# Optional: custom sender name/email shown in the email
SMTP_FROM="Dental Esthetique <your-smtp-username@gmail.com>"
# Where patient appointment requests are delivered (doctors / clinic inbox)
MAIL_TO=your-clinic-inbox@gmail.com
# Public site URL used for logo images in emails (no trailing slash)
SITE_URL=https://your-site.vercel.app
# Google Apps Script web app URL that appends form submissions to Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
